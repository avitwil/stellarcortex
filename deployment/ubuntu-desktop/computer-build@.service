[Unit]
Description=Build the StellarCortex virtual computer (%i)
Requires=libvirtd.service stellarcortex-desktop-network-guard.service
After=libvirtd.service stellarcortex-desktop-network-guard.service
[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 -I /opt/stellarcortex-desktop-broker/deployment/ubuntu-desktop/installer.py build %i
TimeoutStartSec=5h
Restart=no
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_VSOCK AF_INET AF_INET6
StateDirectory=stellarcortex/desktops/provisioning
StateDirectoryMode=0700
RuntimeDirectory=stellarcortex-desktops
RuntimeDirectoryMode=0711
RuntimeDirectoryPreserve=yes
ReadWritePaths=/var/lib/stellarcortex/desktops /etc/stellarcortex
