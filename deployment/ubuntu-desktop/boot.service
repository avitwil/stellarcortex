[Unit]
Description=Restore approved StellarCortex computers after guarded networking
Requires=libvirtd.service stellarcortex-desktop-network-guard.service
After=libvirtd.service stellarcortex-desktop-network-guard.service stellarcortex-desktop-network-coexistence.service nftables.service
Before=stellarcortex-desktop-broker.service libvirt-guests.service
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/python3 -I /opt/stellarcortex-desktop-broker/deployment/ubuntu-desktop/boot.py
TimeoutStartSec=5min
UMask=0077
[Install]
WantedBy=multi-user.target
