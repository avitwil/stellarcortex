# Copy to /etc/stellarcortex/desktop-network-coexistence.env (root-owned, mode 0644)
# and set the names of your host's existing nftables inet tables and chains.
# Check them with: nft list tables; nft list table inet <name>
STELLARCORTEX_DESKTOP_FW_INPUT_TABLE=filter
STELLARCORTEX_DESKTOP_FW_INPUT_CHAIN=input
STELLARCORTEX_DESKTOP_FW_FORWARD_TABLE=filter
STELLARCORTEX_DESKTOP_FW_FORWARD_CHAIN=forward
# Required: the host interface that carries guest outbound traffic.
STELLARCORTEX_DESKTOP_UPLINK=eth0
